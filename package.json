{
  "name": "doc-base-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "node scripts/hooks.mjs",
    "example:setup": "node scripts/example-setup.mjs",
    "example:validate": "node packages/cli/dist/index.js validate --config examples/knowledge-base/doc-base.yaml",
    "example:build": "node packages/cli/dist/index.js build --config examples/knowledge-base/doc-base.yaml",
    "docs:validate": "node packages/cli/dist/index.js validate",
    "docs:build": "node packages/cli/dist/index.js build",
    "test:package": "node scripts/package-test.mjs",
    "test:e2e": "playwright test",
    "audit:licenses": "node scripts/license-audit.mjs",
    "test:dev": "node scripts/dev-test.mjs",
    "docs:reference": "node scripts/schema-reference.mjs && node scripts/diagnostics-reference.mjs",
    "test:docs": "node scripts/schema-reference.mjs --check && node scripts/diagnostics-reference.mjs --check && node scripts/documentation-test.mjs",
    "test:managers": "node scripts/manager-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "doc-base-extension-example": "file:examples/extension",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miki-open-source/doc-base.git"
  }
}
